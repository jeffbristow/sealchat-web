# =====================================================================
# Seal Chat web interface — wake/.htaccess
# Each connected computer has one small random-named file here. Seal Chat
# asks "has it changed?" every few seconds while web access is on; the web
# server answers "304 Not Modified" from its cache without running PHP.
# relay.php rewrites a file when someone opens the web interface.
# =====================================================================
Options -Indexes
<IfModule mod_headers.c>
    # always ask the server (never answer from a cache), but allow 304s
    Header set Cache-Control "no-cache"
    Header unset Set-Cookie
</IfModule>
<FilesMatch "\.(?!txt$)[^.]+$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
